<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Auditrace Compliance Report</title>
  <style>
    {{ payload.stylesheet }}
  </style>
</head>
<body>
  <header>
    <h1>Auditrace Compliance Evidence Report</h1>
    <p><strong>Framework:</strong> {{ payload.framework }}</p>
    <p><strong>Generated:</strong> {{ payload.generated_at }}</p>
    <p><strong>Evidence window start:</strong> {{ payload.since }}</p>
    <p><strong>Events included:</strong> {{ payload.event_count }}</p>
  </header>

  <section>
    <h2>Chain Integrity</h2>
    <p>
      <strong>Status:</strong>
      {% if payload.integrity.is_valid %}
      Valid
      {% else %}
      Issues detected
      {% endif %}
    </p>
    <p>
      <strong>Valid events:</strong> {{ payload.integrity.valid_events }} / {{ payload.integrity.total_events }}
    </p>
    {% if payload.integrity.broken_links %}
    <h3>Broken Links</h3>
    <ul>
      {% for event_id, reason in payload.integrity.broken_links %}
      <li>{{ event_id }}: {{ reason }}</li>
      {% endfor %}
    </ul>
    {% endif %}
    {% if payload.integrity.invalid_signatures %}
    <h3>Invalid Signatures</h3>
    <ul>
      {% for event_id in payload.integrity.invalid_signatures %}
      <li>{{ event_id }}</li>
      {% endfor %}
    </ul>
    {% endif %}
  </section>

  {% block framework_content %}{% endblock %}

  <section>
    <h2>Sample Evidence Events</h2>
    <table>
      <thead>
        <tr>
          <th>Timestamp</th>
          <th>Event ID</th>
          <th>User</th>
          <th>Provider</th>
          <th>Model</th>
          <th>Risk</th>
        </tr>
      </thead>
      <tbody>
        {% for event in payload.events[:50] %}
        <tr>
          <td>{{ event.timestamp }}</td>
          <td>{{ event.event_id }}</td>
          <td>{{ event.user_id or '-' }}</td>
          <td>{{ event.provider }}</td>
          <td>{{ event.model_id }}</td>
          <td>{{ event.risk_level or '-' }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </section>

  {% if payload.public_key_pem %}
  <section>
    <h2>Verification Key</h2>
    <pre>{{ payload.public_key_pem }}</pre>
  </section>
  {% endif %}

  <footer>
    <p>
      Generated by Auditrace. Retention reminder: keep at least {{ payload.retention_window_days }} days of logs for high-risk use cases.
    </p>
  </footer>
</body>
</html>

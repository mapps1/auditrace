{% extends 'base.html.jinja2' %}

{% block framework_content %}
<section>
	<h2>EU AI Act Article 12 Control Coverage</h2>
	<table>
		<thead>
			<tr>
				<th>Control</th>
				<th>Description</th>
				<th>Pass</th>
				<th>Total</th>
				<th>Coverage</th>
			</tr>
		</thead>
		<tbody>
			{% for control in payload.summary.controls %}
			<tr>
				<td>{{ control.control_id }}</td>
				<td>{{ control.title }}</td>
				<td>{{ control.pass_count }}</td>
				<td>{{ control.total_count }}</td>
				<td>{{ (control.coverage * 100)|round(1) }}%</td>
			</tr>
			{% endfor %}
		</tbody>
	</table>
</section>

<section>
	<h2>Annex IV Evidence Notes</h2>
	<ul>
		<li>Operation-level timestamps and IDs are captured per event.</li>
		<li>Input and output records are represented as hashes for data minimization.</li>
		<li>Human oversight outcomes are recorded through review status fields.</li>
		<li>System and model identifiers are captured for reproducibility.</li>
	</ul>
</section>

{% if payload.summary.findings %}
<section>
	<h2>Findings</h2>
	<ul>
		{% for finding in payload.summary.findings %}
		<li>{{ finding }}</li>
		{% endfor %}
	</ul>
</section>
{% endif %}
{% endblock %}
